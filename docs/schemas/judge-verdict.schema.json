{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hivemill/judge-verdict.schema.json",
  "title": "Judge verdict (harness-neutral)",
  "description": "The judge's decision on one PR head, the last JSON block of the judge session's final message.",
  "type": "object",
  "required": ["verdict", "reasons", "criteria_assessed"],
  "properties": {
    "verdict": {"enum": ["MERGE", "REJECT"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criteria_assessed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "proven"],
        "properties": {
          "id": {"type": "integer"},
          "proven": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
