#!/usr/bin/env python3
"""Fake ssh for placement tests. Every call is appended to $FAKE_CALLS.

Facts come from $FACTORY_SSH_FACTS, a JSON object keyed by host:
{"workerhost": {"mem_mb": 11000, "load1": 0.5, "nproc": 16, "exit": 0}}.
A missing host, or "exit" other than 0, exits with that code (default 255) and prints nothing on stdout.
"""
import json
import os
import sys

argv = sys.argv[1:]
calls = os.environ.get("FAKE_CALLS")
if calls:
    with open(calls, "a") as f:
        f.write(json.dumps({"tool": "ssh", "argv": argv}) + "\n")


def host_of(args):
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return args[i + 1] if i + 1 < len(args) else ""
        if a == "-o":
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        return a
    return ""


host = host_of(argv)
try:
    facts = json.loads(os.environ.get("FACTORY_SSH_FACTS") or "{}")
except json.JSONDecodeError:
    facts = {}
spec = facts.get(host) if isinstance(facts, dict) else None
if not isinstance(spec, dict) or int(spec.get("exit", 0)) != 0:
    print("ssh: unreachable", file=sys.stderr)
    sys.exit(int(spec.get("exit", 255)) if isinstance(spec, dict) else 255)
mem_kb = int(spec["mem_mb"]) * 1024
load = spec.get("load1", 0)
nproc = int(spec.get("nproc", 1))
print(f"MemAvailable: {mem_kb} kB")
print("---")
print(f"{load} 0 0 1/1 1")
print("---")
print(nproc)
