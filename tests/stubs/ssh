#!/bin/sh
# Fake ssh for placement tests. Every call is appended to $FAKE_CALLS as one JSON line.
#
# Facts come from $FACTORY_SSH_FACTS, a JSON object keyed by host:
# {"workerhost": {"mem_mb": 11000, "load1": 0.5, "nproc": 16, "exit": 0}}.
# A missing host, or "exit" other than 0, exits with that code (default 255) and prints nothing on stdout.
# Needs jq (preinstalled on ubuntu-latest and on the box).

if [ -n "${FAKE_CALLS:-}" ]; then
    jq -cn '{tool: "ssh", argv: $ARGS.positional}' --args -- "$@" >>"$FAKE_CALLS" || exit 99
fi

# Host: the argument after "--", else the first non-option argument ("-o" takes a value).
host=""
while [ $# -gt 0 ]; do
    case "$1" in
        --) host="${2:-}"; break ;;
        -o) [ $# -ge 2 ] && shift; shift ;;
        -*) shift ;;
        *) host="$1"; break ;;
    esac
done

facts=${FACTORY_SSH_FACTS:-"{}"}
# Unparseable facts count as an unknown host (exit 255), as before.
out=$(printf '%s' "$facts" | jq -r --arg h "$host" '
    (if type == "object" then .[$h] else null end) as $s
    | if ($s | type) != "object" then "exit 255"
      elif (($s.exit // 0) | tonumber) != 0 then "exit \(($s.exit // 255) | tonumber | floor)"
      else "MemAvailable: \(($s.mem_mb | tonumber | floor) * 1024) kB\n---\n\($s.load1 // 0) 0 0 1/1 1\n---\n\(($s.nproc // 1) | tonumber | floor)"
      end') || out="exit 255"

case "$out" in
    "exit "*)
        echo "ssh: unreachable" >&2
        exit "${out#exit }"
        ;;
esac
printf '%s\n' "$out"
