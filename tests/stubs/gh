#!/usr/bin/env python3
"""Fake `gh` for the bin/factory tests.

State lives in the JSON file named by $FAKE_GH_STATE: {"prs": {<url>: {...pr json...}},
"merge_exit": 0, "merge_stderr": "", "merge_sets_state": null, "merge_removes_pr": false, "merge_lands_msg": null, "merge_lands_after_views": null, "close_exit": 0, "pr_view_sleep": 0}. `pr close` sets the PR CLOSED. A merge call lands a squash on repo_url main (subject merge_lands_msg, the PR head's tree) when merge_lands_msg is set, and the PR reads MERGED from its Nth later `pr view` on (merge_lands_after_views). A merge call sets the PR's state to
merge_sets_state when given (a merge that lands even though gh exits non-zero). Every call is appended to the JSONL file named by
$FAKE_CALLS. `repo_url` is a git remote path: `repo view` returns it and `api .../commits/main` answers with its main sha. `pr list --head X` answers from st['pr_list'] (pr_list_exit / pr_list_raw force a failure or raw output). `pr view`, `pr merge` and `repo view` are supported, and `gh api` answers from st["api"]: a list of rules
{"match": [substr, ...], "out": <str or JSON value>, "file": <path under tests/fixtures/scout>, "exit": 0, "err": ""}; the
first rule whose substrings all occur in the space-joined argv wins (a substring ending in $ must end it); with no rule, `.../commits/main` falls back to repo_url's main sha, else exit 1. Anything else exits 1."""
import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_CALLS"], "a") as f:
    f.write(json.dumps({"tool": "gh", "argv": argv}) + "\n")

try:
    with open(os.environ["FAKE_GH_STATE"]) as f:
        st = json.load(f)
except FileNotFoundError:
    st = {}

if argv[:2] == ["pr", "view"]:
    if st.get("pr_view_sleep"):  # a slow gh (timeout tests)
        import time
        time.sleep(st["pr_view_sleep"])
    if "files" in argv and st.get("files_fail"):  # `--json files` fails (post-merge hook tests)
        print("gh: files unavailable", file=sys.stderr)
        sys.exit(1)
    pr = st.get("prs", {}).get(argv[2])
    if pr is None:
        print(f"gh: no pull request found for {argv[2]}", file=sys.stderr)
        sys.exit(1)
    if st.get("merge_lands_after_views") is not None and "landing_in" in st:  # a merge that lands a few views later
        st["landing_in"] -= 1
        if st["landing_in"] <= 0:
            pr["state"] = "MERGED"
        with open(os.environ["FAKE_GH_STATE"], "w") as f:
            json.dump(st, f)
    print(json.dumps(pr))
elif argv[:2] == ["pr", "list"]:
    if st.get("pr_list_exit"):
        print("gh: pr list failed", file=sys.stderr)
        sys.exit(st["pr_list_exit"])
    head = argv[argv.index("--head") + 1] if "--head" in argv else None
    out = [x for x in st.get("pr_list", []) if head is None or x.get("headRefName") == head]
    print(st["pr_list_raw"] if "pr_list_raw" in st else json.dumps(out))
elif argv[:2] == ["pr", "close"]:
    if argv[2] in st.get("prs", {}):
        st["prs"][argv[2]]["state"] = "CLOSED"
        with open(os.environ["FAKE_GH_STATE"], "w") as f:
            json.dump(st, f)
    if st.get("close_exit"):
        print("gh: close failed", file=sys.stderr)
    sys.exit(st.get("close_exit", 0))
elif argv[:2] == ["pr", "merge"]:
    if st.get("merge_lands_msg"):  # the squash lands on main: a commit with the PR head's tree, subject merge_lands_msg
        import subprocess
        repo, head = st["repo_url"], st["prs"][argv[2]]["headRefOid"]
        run = lambda *a: subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True,
                                        env={**os.environ, "GIT_AUTHOR_NAME": "x", "GIT_AUTHOR_EMAIL": "x@x",
                                             "GIT_COMMITTER_NAME": "x", "GIT_COMMITTER_EMAIL": "x@x"}).stdout.strip()
        new = run("commit-tree", head + "^{tree}", "-p", "refs/heads/main", "-m", st["merge_lands_msg"])
        run("update-ref", "refs/heads/main", new)
    if st.get("merge_lands_after_views") is not None:
        st["landing_in"] = st["merge_lands_after_views"]
        with open(os.environ["FAKE_GH_STATE"], "w") as f:
            json.dump(st, f)
    if st.get("merge_removes_pr"):
        st.get("prs", {}).pop(argv[2], None)  # later `pr view` fails
    if st.get("merge_sets_state") and argv[2] in st.get("prs", {}):
        st["prs"][argv[2]]["state"] = st["merge_sets_state"]
    if st.get("merge_removes_pr") or st.get("merge_sets_state"):
        with open(os.environ["FAKE_GH_STATE"], "w") as f:
            json.dump(st, f)
    if st.get("merge_stderr"):
        print(st["merge_stderr"], file=sys.stderr)
    sys.exit(st.get("merge_exit", 0))
elif argv[:2] == ["run", "list"]:  # st["runs"]: {OWNER/NAME: [run json, newest first]}; run_list_exit forces a failure
    if st.get("run_list_exit"):
        print("gh: run list failed", file=sys.stderr)
        sys.exit(st["run_list_exit"])
    print(json.dumps(st.get("runs", {}).get(argv[argv.index("-R") + 1], [])))
elif argv[:2] == ["repo", "view"]:
    print(json.dumps({"url": st.get("repo_url", "/nonexistent/zz-test-remote.git")}))
elif argv[:1] == ["api"]:
    line = " ".join(argv)
    for rule in st.get("api", []):
        if all(line.endswith(m[:-1]) if m.endswith("$") else m in line for m in rule["match"]):
            if rule.get("sleep"):
                import time
                time.sleep(rule["sleep"])
            if rule.get("exit"):
                print(rule.get("err", "gh: api error"), file=sys.stderr)
                sys.exit(rule["exit"])
            if "file" in rule:
                out = open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "fixtures", "scout", rule["file"])).read()
            else:
                out = rule.get("out", "")
            sys.stdout.write(out if isinstance(out, str) else json.dumps(out))
            sys.exit(0)
    if argv[1].endswith("/commits/main") and "repo_url" in st:
        import subprocess
        print(subprocess.run(["git", "-C", st["repo_url"], "rev-parse", "refs/heads/main"], capture_output=True, text=True).stdout.strip())
        sys.exit(0)
    print("gh: no api fixture for: " + line, file=sys.stderr)
    sys.exit(1)
else:
    print("gh: unsupported by the test stub: " + " ".join(argv), file=sys.stderr)
    sys.exit(1)
