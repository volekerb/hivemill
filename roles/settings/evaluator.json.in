{
  "attribution": {"pr": ""},
  "permissions": {
    "deny": [
      "Advisor",
      "Bash(gh pr merge:*)",
      "Bash(sqlite3:*)",
      "Bash(herdr server stop:*)",
      "Bash(hc server stop:*)",
      "Bash(herdr-core server stop:*)",
      "Bash(hc kill:*)",
      "Bash(hc rm:*)",
      "Bash(hc run:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Write(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Write(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Write(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Write(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Write(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Write(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Write(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Write(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "MultiEdit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Edit(/@FACTORY_USER_CONFIG@/factory)",
      "Write(/@FACTORY_USER_CONFIG@/factory)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/**)",
      "Write(/@FACTORY_USER_CONFIG@/factory/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Write(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(herdr:*)",
      "Edit(/@FACTORY_LIVE_HOME@/**)",
      "Write(/@FACTORY_LIVE_HOME@/**)",
      "Edit(/@FACTORY_HOME_DIR@/.claude/**)",
      "Write(/@FACTORY_HOME_DIR@/.claude/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": false,
    "engineering@synced": false,
    "design@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HERDR_SOCKET_PATH": "/proc/nonexistent/worker-no-herdr.sock",
    "FACTORY_ROLE": "evaluator",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role evaluator",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role evaluator",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_SOCKET_PATH=@FACTORY_HOME_DIR@/.config/herdr/herdr.sock @FACTORY_HOME_DIR@/.claude/statusline-usage.sh"
  }
}
