{
  "attribution": {"pr": ""},
  "permissions": {
    "deny": [
      "Advisor",
      "Bash(gh pr merge:*)",
      "Bash(sqlite3:*)",
      "Bash(claude:*)",
      "Bash(herdr server stop:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Write(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Write(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Write(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Write(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Write(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Write(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Write(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(factory spawn cleaner)",
      "Bash(factory spawn cleaner *)",
      "Bash(factory spawn pm *)",
      "Bash(factory spawn coder *)",
      "Bash(factory spawn qa *)",
      "Bash(factory spawn reviewer *)",
      "Bash(factory spawn judge *)",
      "Bash(factory project update * --gh *)",
      "Bash(factory config nudge_cooldown_s *)",
      "Bash(factory config director_cycle_s *)",
      "Bash(factory config blocked_alert_s *)",
      "Bash(factory config hq_unblock_s *)",
      "Bash(factory config stop_timeout_s *)",
      "Bash(factory config judge_ci_wait_s *)",
      "Bash(factory config judge_max_refreshes *)",
      "Bash(factory config dispatch_max_per_tick *)",
      "Bash(factory config dispatch_max_team_workers *)",
      "Bash(factory config test_slots *)",
      "Bash(factory config gate_max_parallel *)",
      "Bash(factory config scout_triage_per_run *)",
      "Bash(factory config scout_max_minutes *)",
      "Bash(factory config recycle_context_tokens *)",
      "Bash(factory stop *)",
      "Bash(factory task update *)",
      "Bash(factory task add *)",
      "Bash(factory task note *)",
      "Bash(factory task reopen *)",
      "Bash(factory relaunch *)",
      "Bash(factory dequeue *)",
      "Bash(factory unblock *)",
      "Bash(factory team *)",
      "Bash(factory eval *)",
      "Bash(factory goal signoff *)",
      "Bash(factory goal close *)",
      "Bash(factory goal status *)",
      "Bash(factory clean)",
      "Bash(factory clean --dry-run)",
      "Bash(factory clean --remote-branch factory/*)",
      "Bash(factory judge * --record-merged *)",
      "Bash(factory msg *)",
      "Bash(factory digest *)",
      "Bash(factory inbox)",
      "Bash(factory inbox *)",
      "Bash(factory res)",
      "Bash(factory agents)",
      "Bash(factory agents *)",
      "Bash(factory goal list)",
      "Bash(factory goal show *)",
      "Bash(factory task show *)",
      "Bash(factory task ready *)",
      "Bash(factory task list *)",
      "Bash(factory scorecard *)",
      "Bash(factory config)"
    ],
    "ask": [
      "Bash(factory project * --gate-cmd*)",
      "Bash(factory project * --gate-count-cmd*)",
      "Bash(factory project * --gate-c*)",
      "Bash(factory project * --rep*)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: single-owner AI agent factory on one Proxmox VM; agents run unattended overnight while the owner sleeps.",
      "Org-specific CLIs: `factory` (~/factory/bin/factory) is the factory's trusted orchestration CLI. It enforces role permissions, owner caps, the resource spawn gate and the head-SHA merge gate itself. `factory spawn` is the only sanctioned way to start agents."
    ],
    "allow": [
      "$defaults",
      "Factory orchestration: the director running `factory spawn` (pm, coder, qa, reviewer, judge, cleaner), `factory stop`, `factory relaunch`, `factory dequeue`, `factory task|team|goal` updates, `factory project update <id> --gh OWNER/NAME` and `factory config` on non-cap tuning keys is routine and allowed. Changing owner caps (max_live_*, max_total_claude, *_pct, min_mem_available_mb, reserved_worker_slots, lead_parking, gate_max_load_ratio) is NOT covered."
    ]
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "FACTORY_ROLE": "director",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "caveman"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --hq"
          }
        ]
      }
    ]
  }
}