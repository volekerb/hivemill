{
  "attribution": {"pr": ""},
  "permissions": {
    "deny": [
      "Advisor",
      "Bash(gh pr merge:*--admin*)",
      "Bash(gh pr merge:*--auto*)",
      "Bash(gh pr merge:*--merge*)",
      "Bash(gh pr merge:*--rebase*)",
      "Bash(sqlite3:*)",
      "Bash(claude:*)",
      "Bash(herdr server stop:*)",
      "Bash(hc server stop:*)",
      "Bash(herdr-core server stop:*)",
      "Bash(hc kill:*)",
      "Bash(hc rm:*)",
      "Bash(hc run:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Write(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Write(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Write(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Write(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Write(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Write(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Write(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Write(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "MultiEdit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge * --squash --delete-branch)",
      "Bash(gh pr merge * --squash --delete-branch --repo volekerb/hivemill)",
      "Bash(gh pr merge * --squash --delete-branch --repo volekerb/hivemill-www)",
      "Bash(gh pr merge * --repo volekerb/hivemill --squash --delete-branch)",
      "Bash(gh pr merge * --repo volekerb/hivemill-www --squash --delete-branch)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ]
  },
  "env": {
    "FACTORY_ROLE": "boss",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40",
    "BASH_MAX_OUTPUT_LENGTH": "40000",
    "MAX_MCP_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "25000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --hq --role boss"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/boss-inbox.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}