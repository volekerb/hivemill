      "Write(/@FACTORY_LIVE_HOME@/SECURITY.md/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/SECURITY.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/CODE_OF_CONDUCT.md)",
