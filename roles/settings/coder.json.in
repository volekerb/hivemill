      "NotebookEdit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/scout)",
      "Write(/@FACTORY_LIVE_HOME@/scout)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/scout)",
      "Edit(/@FACTORY_LIVE_HOME@/scout/**)",
      "Write(/@FACTORY_LIVE_HOME@/scout/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/scout/**)",
      "Edit(/@FACTORY_LIVE_HOME@/skilleval)",
      "Write(/@FACTORY_LIVE_HOME@/skilleval)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/skilleval)",
      "Edit(/@FACTORY_LIVE_HOME@/skilleval/**)",
      "Write(/@FACTORY_LIVE_HOME@/skilleval/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/skilleval/**)",
      "Edit(/@FACTORY_LIVE_HOME@/systemd)",
      "Write(/@FACTORY_LIVE_HOME@/systemd)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/systemd)",
      "Edit(/@FACTORY_LIVE_HOME@/systemd/**)",
      "Write(/@FACTORY_LIVE_HOME@/systemd/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/systemd/**)",
      "Edit(/@FACTORY_LIVE_HOME@/tests)",
      "Write(/@FACTORY_LIVE_HOME@/tests)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/tests)",
      "Edit(/@FACTORY_LIVE_HOME@/tests/**)",
      "Write(/@FACTORY_LIVE_HOME@/tests/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/tests/**)",
      "Edit(/@FACTORY_LIVE_HOME@/web)",
      "Write(/@FACTORY_LIVE_HOME@/web)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/web)",
      "Edit(/@FACTORY_LIVE_HOME@/web/**)",
      "Write(/@FACTORY_LIVE_HOME@/web/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/web/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.git)",
      "Write(/@FACTORY_LIVE_HOME@/.git)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.git)",
      "Edit(/@FACTORY_LIVE_HOME@/.git/**)",
      "Write(/@FACTORY_LIVE_HOME@/.git/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.git/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git push origin HEAD:factory/*)",
      "Bash(gh pr create --repo volekerb/hivemill *)",
      "Bash(gh pr ready --repo volekerb/hivemill *)",
      "Bash(gh pr ready * --repo volekerb/hivemill)"
    ]
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HERDR_SOCKET_PATH": "/proc/nonexistent/worker-no-herdr.sock",
    "FACTORY_ROLE": "coder",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --role coder"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --role coder"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_SOCKET_PATH=@FACTORY_HOME_DIR@/.config/herdr/herdr.sock @FACTORY_HOME_DIR@/.claude/statusline-usage.sh"
  }
}