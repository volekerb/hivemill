      "Write(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Write(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Write(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory)",
      "Write(/@FACTORY_USER_CONFIG@/factory)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/**)",
      "Write(/@FACTORY_USER_CONFIG@/factory/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Write(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Edit(/@FACTORY_LIVE_HOME@/.github)",
      "Write(/@FACTORY_LIVE_HOME@/.github)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.github)",
      "Edit(/@FACTORY_LIVE_HOME@/.github/**)",
      "Write(/@FACTORY_LIVE_HOME@/.github/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.github/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.gitignore)",
      "Write(/@FACTORY_LIVE_HOME@/.gitignore)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.gitignore)",
      "Edit(/@FACTORY_LIVE_HOME@/.gitignore/**)",
      "Write(/@FACTORY_LIVE_HOME@/.gitignore/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.gitignore/**)",
      "Edit(/@FACTORY_LIVE_HOME@/README.md)",
      "Write(/@FACTORY_LIVE_HOME@/README.md)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/README.md)",
      "Edit(/@FACTORY_LIVE_HOME@/README.md/**)",
      "Write(/@FACTORY_LIVE_HOME@/README.md/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/README.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/LICENSE)",
      "Write(/@FACTORY_LIVE_HOME@/LICENSE)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/LICENSE)",
      "Edit(/@FACTORY_LIVE_HOME@/LICENSE/**)",
      "Write(/@FACTORY_LIVE_HOME@/LICENSE/**)",
