      "Edit(/@FACTORY_LIVE_HOME@/docs/**)",
      "Write(/@FACTORY_LIVE_HOME@/docs/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/docs/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles)",
      "Write(/@FACTORY_LIVE_HOME@/roles)",
