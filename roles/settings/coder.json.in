      "Edit(/@FACTORY_LIVE_HOME@/THIRD_PARTY.md/**)",
      "Write(/@FACTORY_LIVE_HOME@/THIRD_PARTY.md/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/THIRD_PARTY.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/CONTRIBUTING.md)",
      "Write(/@FACTORY_LIVE_HOME@/CONTRIBUTING.md)",
