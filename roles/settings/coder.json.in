      "Edit(/@FACTORY_LIVE_HOME@/.editorconfig)",
      "Write(/@FACTORY_LIVE_HOME@/.editorconfig)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.editorconfig)",
      "Edit(/@FACTORY_LIVE_HOME@/.editorconfig/**)",
      "Write(/@FACTORY_LIVE_HOME@/.editorconfig/**)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/.editorconfig/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin)",
      "Write(/@FACTORY_LIVE_HOME@/bin)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/bin)",
      "NotebookEdit(/@FACTORY_LIVE_HOME@/bin/**)",
