{
  "attribution": {"pr": ""},
  "permissions": {
    "deny": [
      "Advisor",
      "Bash(gh pr merge:*)",
      "Bash(sqlite3:*)",
      "Bash(herdr server stop:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Write(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Write(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Write(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Write(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Write(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Write(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Write(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory)",
      "Write(/@FACTORY_USER_CONFIG@/factory)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/**)",
      "Write(/@FACTORY_USER_CONFIG@/factory/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Write(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(factory judge * --merge *)",
      "Bash(factory judge * --reject *)",
      "Bash(factory task show *)",
      "Bash(factory inbox)",
      "Bash(factory inbox *)",
      "Bash(factory done *)",
      "Bash(factory gate show *)",
      "Bash(git merge-base --is-ancestor origin/main *)",
      "Bash(git fetch origin)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: single-owner AI agent factory on one Proxmox VM; agents run unattended overnight while the owner sleeps.",
      "Org-specific CLIs: `factory` (~/factory/bin/factory) is the factory's trusted orchestration CLI. It enforces role permissions, owner caps, the resource spawn gate and the head-SHA merge gate itself. `factory spawn` is the only sanctioned way to start agents."
    ],
    "allow": [
      "$defaults",
      "Factory merge gate: the judge running `factory judge <task> --merge|--reject --reason \u2026` is routine and allowed; the CLI performs the squash-merge with its own checks."
    ]
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HERDR_SOCKET_PATH": "/proc/nonexistent/worker-no-herdr.sock",
    "FACTORY_ROLE": "judge",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --role judge"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --role judge"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @FACTORY_LIVE_HOME@/roles/hooks/worker-guard.py --role judge"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_SOCKET_PATH=@FACTORY_HOME_DIR@/.config/herdr/herdr.sock @FACTORY_HOME_DIR@/.claude/statusline-usage.sh"
  }
}