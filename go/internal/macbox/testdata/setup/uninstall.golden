#!/bin/sh
# Hivemill macbox owner script (ADR 0003 section 3.2). Read it, then run it
# with: sudo sh uninstall.sh
# It is printed by macbox-setup; the factory never runs it.
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root with sudo: sudo sh $0" >&2
  exit 1
fi
if [ "${SUDO_USER:-}" != 'a' ]; then
  echo "must be run with sudo by the owner a (SUDO_USER=${SUDO_USER:-unset})" >&2
  exit 1
fi

LAUNCHER='/usr/local/libexec/hivemill/macbox-launch'
LAUNCHER_DIR='/usr/local/libexec/hivemill'
OWNER_HOME='/Users/a'
FACTORY_HOME='/Users/a/factory'

echo "undo step acl: remove the group ACL entries"
if [ -d "$OWNER_HOME" ] && [ -d "$FACTORY_HOME" ]; then

HOME_REAL=$(cd "$OWNER_HOME" && pwd -P)
FACTORY_REAL=$(cd "$FACTORY_HOME" && pwd -P)
ACL_OK=1
if [ "$HOME_REAL" = / ]; then
  echo "owner home resolves to /; skipping ACL undo" >&2
  ACL_OK=0
else
  case "$FACTORY_REAL" in
    "$HOME_REAL"/?*) ;;
    *)
      echo "factory home resolves to $FACTORY_REAL, not strictly inside owner home $HOME_REAL; skipping ACL undo" >&2
      ACL_OK=0
      ;;
  esac
fi

  if [ "$ACL_OK" -eq 1 ]; then
  if [ -d "$FACTORY_REAL/db" ]; then chmod -R -a "group:_hivemill allow add_file,add_subdirectory,delete_child,write,append,writeattr,writeextattr,file_inherit,directory_inherit" "$FACTORY_REAL/db" || echo "  db entries already absent"; fi
  chmod -R -a "group:_hivemill allow list,search,readattr,readextattr,readsecurity,read,execute,file_inherit,directory_inherit" "$FACTORY_REAL" || echo "  factory entries already absent"
  d=$(dirname "$FACTORY_REAL")
  while [ "$d" != "$HOME_REAL" ] && [ "$d" != / ]; do
    chmod -a "group:_hivemill allow search" "$d" || echo "  $d entry already absent"
    d=$(dirname "$d")
  done
  chmod -a "group:_hivemill allow search" "$HOME_REAL" || echo "  home entry already absent"
  fi
else
  echo "  owner or factory home missing, skipping"
fi

echo "undo step sudoers: remove /etc/sudoers.d/hivemill"
rm -f /etc/sudoers.d/hivemill

echo "undo step launcher: remove the launcher (parent directories above $LAUNCHER_DIR are kept)"
rm -f "$LAUNCHER"
if [ -d "$LAUNCHER_DIR" ]; then rmdir "$LAUNCHER_DIR" || echo "  $LAUNCHER_DIR not empty, keeping"; fi

echo "undo step accounts: delete accounts and group"
for u in _hivemill_ro _hivemill_rw; do
  if dscl . -read "/Users/$u" >/dev/null 2>&1; then dscl . -delete "/Users/$u"; else echo "  $u absent"; fi
done
if dscl . -read /Groups/_hivemill >/dev/null 2>&1; then dscl . -delete /Groups/_hivemill; else echo "  group _hivemill absent"; fi

echo "done."
