#!/bin/sh
# Verifier shim for the Hivemill installer. It downloads the hivemill-install release build for this plugin
# version, checks its sha256 against the value pinned below, then runs it with all arguments. Any mismatch, a
# missing tool or an unknown platform stops it with a non-zero exit before anything is executed.
# The pinned values are written by the release process (docs/RELEASING.md); 64 zeros means "not pinned yet".
set -eu

VERSION="0.5.0"
SHA_LINUX_AMD64="073cf6af1a34548ba8bf258f05d7dce227fc2f484a6eab726ca0735bf07042dd"
SHA_LINUX_ARM64="8775cbd7c8fc14ddbcf1aa6281f0231f7134e3e0a2d841b4553c8ad0dabf2d5b"
SHA_DARWIN_ARM64="15b7001449285718d04cb21c7ff859234dcc5d637512537851f3c5a4bd5df3ce"

die() { echo "install: $*" >&2; exit 1; }

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64 | Linux-amd64) plat=linux-amd64; want=$SHA_LINUX_AMD64 ;;
  Linux-aarch64 | Linux-arm64) plat=linux-arm64; want=$SHA_LINUX_ARM64 ;;
  Darwin-arm64) plat=darwin-arm64; want=$SHA_DARWIN_ARM64 ;;
  *) die "no hivemill-install build for $(uname -s) $(uname -m)" ;;
esac

if command -v sha256sum >/dev/null 2>&1; then hasher="sha256sum"
elif command -v shasum >/dev/null 2>&1; then hasher="shasum -a 256"
else die "need sha256sum or shasum to verify the download"; fi
command -v curl >/dev/null 2>&1 || die "need curl to download hivemill-install"

# HIVEMILL_INSTALL_BASE_URL only moves the download (tests, mirrors); the pinned sha256 still decides.
base=${HIVEMILL_INSTALL_BASE_URL:-https://github.com/volekerb/hivemill/releases/download/v$VERSION}
case "$base" in
  https://* | file://*) ;;
  *) die "refusing a download base that is not https:// or file://" ;;
esac
asset="hivemill-install-$plat"

umask 077
dir=${XDG_CACHE_HOME:-${HOME:?HOME is not set}/.cache}/hivemill-install/$VERSION
mkdir -p "$dir"
bin="$dir/$asset"
part="$bin.part.$$"
trap 'rm -f "$part"' EXIT

sum_of() { $hasher "$1" | cut -d' ' -f1; }
if [ ! -f "$bin" ] || [ "$(sum_of "$bin")" != "$want" ]; then
  curl -fsSL --proto '=https,file' --proto-redir '=https' --max-time 300 -o "$part" "$base/$asset" ||
    die "cannot download $base/$asset"
  got=$(sum_of "$part")
  [ "$got" = "$want" ] || die "sha256 mismatch for $asset: got $got, pinned $want; nothing was run"
  chmod 700 "$part"
  mv -f "$part" "$bin"
fi
[ "$(sum_of "$bin")" = "$want" ] || die "sha256 mismatch for the cached $asset; nothing was run"

HIVEMILL_PLUGIN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export HIVEMILL_PLUGIN_ROOT
trap - EXIT
exec "$bin" "$@"
