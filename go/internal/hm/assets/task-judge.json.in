{
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(sqlite3:*)",
      "Bash(herdr server stop:*)",
      "Bash(hc server stop:*)",
      "Bash(herdr-core server stop:*)",
      "Bash(hc kill:*)",
      "Bash(hc rm:*)",
      "Bash(hc run:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Edit(/@FACTORY_USER_CONFIG@/factory)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(~/.local/go/bin/go test:*)",
      "Bash(~/.local/go/bin/go vet:*)",
      "Bash(~/.local/go/bin/go build:*)",
      "Bash(~/.local/go/bin/go run:*)",
      "Bash(~/.local/go/bin/go list:*)",
      "Bash(~/.local/go/bin/go env:*)",
      "Bash(~/.local/go/bin/go version:*)",
      "Bash(~/.local/go/bin/gofmt -l:*)",
      "Bash(~/.local/go/bin/gofmt -d:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go test:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go vet:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go build:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go run:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go list:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go env:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/go version:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/gofmt -l:*)",
      "Bash(GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOMODCACHE=~/.local/lib/factory/go/mod ~/.local/go/bin/gofmt -d:*)",
      "Workflow(reviewer-skills:multi-angle-review)"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": false,
    "engineering@synced": false,
    "design@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HERDR_SOCKET_PATH": "/proc/nonexistent/worker-no-herdr.sock",
    "FACTORY_ROLE": "task-judge",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role reviewer",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role reviewer",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role reviewer",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@FACTORY_HOME_DIR@/.local/bin/hivemill judge hook",
            "timeout": 1800
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@FACTORY_HOME_DIR@/.local/bin/hivemill run hook-session",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_SOCKET_PATH=@FACTORY_HOME_DIR@/.config/herdr/herdr.sock @FACTORY_HOME_DIR@/.claude/statusline-usage.sh"
  },
  "promptCacheTtl": "5m",
  "subagentPromptCacheTtl": "5m"
}
