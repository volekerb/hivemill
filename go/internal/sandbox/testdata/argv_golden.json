{
 "gatebox_plain": {
  "argv": [
   "/usr/bin/unshare",
   "-r",
   "-n",
   "-m",
   "--pid",
   "--fork",
   "--kill-child",
   "--mount-proc",
   "--propagation",
   "private",
   "@SELF@",
   "--setup",
   {
    "claude": null,
    "cwd": "@ROOT@/gate",
    "env_set": {},
    "forward_sock": null,
    "gid": 1000,
    "hide_dirs": [
     "@ROOT@/hm",
     "@ROOT@/run",
     "/tmp",
     "/dev/shm",
     "/var/tmp",
     "/run"
    ],
    "hide_files": [],
    "keep": [],
    "keep_ro": [],
    "masks": [
     "@ROOT@/main/db",
     "@ROOT@/main/logs",
     "@ROOT@/main/worktrees"
    ],
    "mode": "allow",
    "net": false,
    "ro": [
     "@ROOT@/main",
     "@ROOT@/outside.git",
     "@ROOT@/gate/.git"
    ],
    "rw": [
     "@ROOT@/gate",
     "@ROOT@/wt/reports",
     "@ROOT@/wt/factory-home",
     "@ROOT@/wt/tmp"
    ],
    "scrub": [
     "SSH_AUTH_SOCK",
     "DBUS_SESSION_BUS_ADDRESS",
     "CLAUDE_CODE_OAUTH_TOKEN",
     "ANTHROPIC_API_KEY",
     "ANTHROPIC_AUTH_TOKEN",
     "HTTPS_PROXY",
     "https_proxy",
     "HTTP_PROXY",
     "http_proxy",
     "ALL_PROXY",
     "all_proxy"
    ],
    "self": "@SELF@",
    "setpriv": "/usr/bin/setpriv",
    "tmpfs_sizes": {
     "/dev/shm": "16m",
     "/tmp": "64m",
     "/var/tmp": "16m"
    },
    "trial": "@ROOT@/wt/reports",
    "trials_root": "@ROOT@/wt",
    "uid": 1000,
    "unshare": "/usr/bin/unshare"
   },
   "--",
   "bash",
   "-c",
   "make test 'x y'"
  ],
  "env": {
   "FACTORY_GATEBOX": "1",
   "FACTORY_HOME": "/live",
   "FACTORY_MAIN": "@ROOT@/main",
   "GATE_REPORT_DIR": "@ROOT@/wt/reports",
   "GATE_SHARDS": "2",
   "HOME": "@ROOT@/hm",
   "LANG": "C",
   "LC_ALL": "C",
   "PATH": "/usr/bin",
   "PYTHONDONTWRITEBYTECODE": "1",
   "PYTHONPYCACHEPREFIX": "@ROOT@/wt/tmp/pycache",
   "TMPDIR": "@ROOT@/wt/tmp"
  }
 },
