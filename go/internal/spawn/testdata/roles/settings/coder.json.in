{
  "attribution": {"pr": ""},
  "permissions": {
    "deny": [
      "Advisor",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create*)",
      "Bash(gh pr ready*)",
      "Bash(sqlite3:*)",
      "Bash(herdr server stop:*)",
      "Bash(hc server stop:*)",
      "Bash(herdr-core server stop:*)",
      "Bash(hc kill:*)",
      "Bash(hc rm:*)",
      "Bash(hc run:*)",
      "Bash(herdr workspace close:*)",
      "Bash(herdr tab close:*)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr workspace create:*)",
      "Bash(herdr tab create:*)",
      "Bash(herdr pane split:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin HEAD:factory/* *)",
      "Bash(rm -rf ~/factory:*)",
      "Bash(rm -rf @FACTORY_LIVE_HOME@:*)",
      "Edit(/@FACTORY_LIVE_HOME@/factory.db*)",
      "Edit(/@FACTORY_LIVE_HOME@/db/**)",
      "Edit(/@FACTORY_LIVE_HOME@/exports/**)",
      "Edit(/@FACTORY_LIVE_HOME@/state/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/settings/**)",
      "Edit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "MultiEdit(/@FACTORY_LIVE_HOME@/run/guard-export.json*)",
      "Edit(/@FACTORY_LIVE_HOME@/audit.log)",
      "Edit(/@FACTORY_LIVE_HOME@/audit.log*)",
      "Edit(/@FACTORY_LIVE_HOME@/run)",
      "Edit(/@FACTORY_LIVE_HOME@/run/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/**)",
      "Edit(/@FACTORY_USER_CONFIG@/factory/live_home)",
      "Edit(/@FACTORY_LIVE_HOME@/.github)",
      "Edit(/@FACTORY_LIVE_HOME@/.github/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.gitignore)",
      "Edit(/@FACTORY_LIVE_HOME@/.gitignore/**)",
      "Edit(/@FACTORY_LIVE_HOME@/README.md)",
      "Edit(/@FACTORY_LIVE_HOME@/README.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/LICENSE)",
      "Edit(/@FACTORY_LIVE_HOME@/LICENSE/**)",
      "Edit(/@FACTORY_LIVE_HOME@/THIRD_PARTY.md)",
      "Edit(/@FACTORY_LIVE_HOME@/THIRD_PARTY.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/CONTRIBUTING.md)",
      "Edit(/@FACTORY_LIVE_HOME@/CONTRIBUTING.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/SECURITY.md)",
      "Edit(/@FACTORY_LIVE_HOME@/SECURITY.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/CODE_OF_CONDUCT.md)",
      "Edit(/@FACTORY_LIVE_HOME@/CODE_OF_CONDUCT.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/CHANGELOG.md)",
      "Edit(/@FACTORY_LIVE_HOME@/CHANGELOG.md/**)",
      "Edit(/@FACTORY_LIVE_HOME@/VERSION)",
      "Edit(/@FACTORY_LIVE_HOME@/VERSION/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.editorconfig)",
      "Edit(/@FACTORY_LIVE_HOME@/.editorconfig/**)",
      "Edit(/@FACTORY_LIVE_HOME@/bin)",
      "Edit(/@FACTORY_LIVE_HOME@/ci)",
      "Edit(/@FACTORY_LIVE_HOME@/ci/**)",
      "Edit(/@FACTORY_LIVE_HOME@/plugins)",
      "Edit(/@FACTORY_LIVE_HOME@/plugins/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.claude-plugin)",
      "Edit(/@FACTORY_LIVE_HOME@/.claude-plugin/**)",
      "Edit(/@FACTORY_LIVE_HOME@/go)",
      "Edit(/@FACTORY_LIVE_HOME@/go/**)",
      "Edit(/@FACTORY_LIVE_HOME@/docs)",
      "Edit(/@FACTORY_LIVE_HOME@/docs/**)",
      "Edit(/@FACTORY_LIVE_HOME@/roles)",
      "Edit(/@FACTORY_LIVE_HOME@/scout)",
      "Edit(/@FACTORY_LIVE_HOME@/scout/**)",
      "Edit(/@FACTORY_LIVE_HOME@/retro/**)",
      "Edit(/@FACTORY_LIVE_HOME@/skilleval)",
      "Edit(/@FACTORY_LIVE_HOME@/skilleval/**)",
      "Edit(/@FACTORY_LIVE_HOME@/launchd)",
      "Edit(/@FACTORY_LIVE_HOME@/launchd/**)",
      "Edit(/@FACTORY_LIVE_HOME@/systemd)",
      "Edit(/@FACTORY_LIVE_HOME@/systemd/**)",
      "Edit(/@FACTORY_LIVE_HOME@/tests)",
      "Edit(/@FACTORY_LIVE_HOME@/tests/**)",
      "Edit(/@FACTORY_LIVE_HOME@/web)",
      "Edit(/@FACTORY_LIVE_HOME@/web/**)",
      "Edit(/@FACTORY_LIVE_HOME@/.git)",
      "Edit(/@FACTORY_LIVE_HOME@/.git/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(factory:*)",
      "Bash(factory pr create *)",
      "Bash(factory pr ready)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git push origin HEAD:factory/*)",
      "Workflow(coder-skills:multi-angle-review)"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": false,
    "engineering@synced": false,
    "design@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HERDR_SOCKET_PATH": "/proc/nonexistent/worker-no-herdr.sock",
    "FACTORY_ROLE": "coder",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role coder",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role coder",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh @FACTORY_LIVE_HOME@/roles/hooks/worker-guard --role coder",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_SOCKET_PATH=@FACTORY_HOME_DIR@/.config/herdr/herdr.sock @FACTORY_HOME_DIR@/.claude/statusline-usage.sh"
  }
}