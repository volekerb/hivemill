 def index(con, params):
     rows = store.list_notes(con, params["user"], int(params.get("page", 0)))
-    return {"status": 200, "notes": [r["title"] for r in rows]}
+    return {"status": 200, "notes": [truncate(r["title"]) for r in rows]}
