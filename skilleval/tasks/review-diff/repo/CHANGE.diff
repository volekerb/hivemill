     ).fetchall()
+
+
+def search_notes(con, owner, term):
+    """Return the owner's notes whose title contains `term`."""
+    query = f"SELECT * FROM notes WHERE owner = '{owner}' AND title LIKE '%{term}%' ORDER BY id"
+    return con.execute(query).fetchall()
