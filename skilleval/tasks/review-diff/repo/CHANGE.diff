+
+def search(con, params):
+    term = params.get("q", "").strip()
+    if not term:
+        return {"status": 400, "error": "q required"}
+    rows = store.search_notes(con, params["user"], term)
+    return {"status": 200, "notes": [truncate(r["title"]) for r in rows]}
