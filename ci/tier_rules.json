{
  "docs_globs": ["docs/**", "*.md"],
  "docs_excluded_prefixes": ["roles/", "ci/", ".github/", "bin/"],
  "tests_globs": ["tests/test_*.py", "tests/fixtures/**"],
  "sensitive_paths": [
    ".github/**",
    "ci/public_text_guard.py", "ci/publish_repo.py", "ci/scrub_*", "ci/guard_*", "ci/test_count_gate.py",
    "ci/affected.py", "ci/risk_tier.py", "ci/tier_rules.json",
    "roles/settings/**", "roles/hooks/**", "roles/*.md",
    "scout/nsbox.py", "scout/sandbox.py", "scout/workerbox.py", "scout/egress.py",
    "go/internal/guard/**", "go/cmd/worker-guard/**", "go/internal/shlex/**"
  ],
  "sensitive_defs": {
    "bin/factory": [
      "cmd_judge", "cmd_verdict", "judge_*", "_judge_*", "train_*", "record_merged", "verify_merged_externally", "merge_freeze_refusal", "task_merge_lock", "ci_verdict", "clean_verdict", "mech_*", "cmd_mech_merge", "tick_mech_merge", "red_main_*", "_red_main_*", "verdict_carries", "head_has_main", "verified_main", "refresh_branch", "gate*",
      "git_config_guard", "noreply_email", "_push_policy", "require_role", "OWNER_CAP_KEYS", "DEFAULT_CONFIG", "SCHEMA",
      "<stmt>"
    ],
    "bin/factory_cli.py": [
      "cmd_judge", "cmd_verdict", "judge_*", "_judge_*", "train_*", "record_merged", "verify_merged_externally", "merge_freeze_refusal", "task_merge_lock", "ci_verdict", "clean_verdict", "mech_*", "cmd_mech_merge", "tick_mech_merge", "red_main_*", "_red_main_*", "verdict_carries", "head_has_main", "verified_main", "refresh_branch", "gate*",
      "git_config_guard", "noreply_email", "_push_policy", "require_role", "OWNER_CAP_KEYS", "DEFAULT_CONFIG", "SCHEMA",
      "<stmt>"
    ]
  },
  "small_lines": 150,
  "large_lines": 600
}
