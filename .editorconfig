root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[bin/factory]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,css,html}]
indent_style = space
indent_size = 2

[{ci/guard_corpus.json,tests/fixtures/spawn_golden_main.json}]
indent_size = 1

[{Makefile,*.go}]
indent_style = tab

[*.diff]
trim_trailing_whitespace = false
