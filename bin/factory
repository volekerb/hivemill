#!/usr/bin/env python3
"""factory entry (factory_cli.py). G-041 cli_impl may exec factory-go; G-038 schedule is Go-only."""
import os, sys
_BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _BIN)
if len(sys.argv) > 1 and sys.argv[1] == "schedule":
    if os.environ.get("FACTORY_CLI_IMPL") == "python":
        from factory_cli import _SCHEDULE_GO_MSG
        print(f"factory: {_SCHEDULE_GO_MSG}", file=sys.stderr)
        sys.exit(2)
    from factory_cli import exec_schedule_go; exec_schedule_go(sys.argv)
try:
    lib, home = os.path.expanduser("~/.local/lib/factory/"), os.environ.get("FACTORY_HOME", os.path.expanduser("~/factory"))
    mode, srchash, cmds = open(os.path.join(home, "run", "cli_impl")).read(4096).split(" ", 2)
    if mode == "go" and srchash and os.environ.get("FACTORY_CLI_IMPL") != "python" and sys.argv[1] in cmds.strip().split(",") \
            and open(lib + "factory-go.stamp").read(4096).strip() == srchash and os.access(lib + "factory-go", os.X_OK):
        print("impl=go", file=sys.stderr, flush=True) if os.environ.get("FACTORY_CLI_TRACE") == "1" else None
        os.execv(lib + "factory-go", [sys.argv[0], *sys.argv[1:]])
except (OSError, ValueError, IndexError):
    pass
import factory_cli
factory_cli.main()