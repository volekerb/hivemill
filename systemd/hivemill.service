[Unit]
Description=hivemill daemon: the Option B pass loop (docs/option-b-runner.md#running-unattended)
After=factory-up.service
[Service]
Type=notify
NotifyAccess=main
Environment=PATH=%h/.local/bin:%h/.local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/hivemill daemon
Restart=always
RestartSec=10
# a pass pings the watchdog when it ends; one pass can wait for a session's TUI and a gh call or two
WatchdogSec=900
TimeoutStopSec=600
KillMode=process
[Install]
WantedBy=default.target
