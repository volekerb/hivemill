[Unit]
Description=hivemill obs: the read-only dashboard (docs/hivemill-observability.md)
After=hivemill.service
[Service]
Environment=PATH=%h/.local/bin:%h/.local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/hivemill obs
Restart=always
RestartSec=10
[Install]
WantedBy=default.target
